{
  "name": "rafaelmedina.me",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir .ssr && node scripts/prerender.mjs",
    "lint": "eslint . && npm run lint:css",
    "lint:css": "stylelint \"src/**/*.css\"",
    "preview": "vite preview",
    "test:e2e": "VITE_LIKES_API_URL=${LIKES_API_URL:-http://127.0.0.1:8787} npm run build && playwright test",
    "test:design-system": "playwright test --config playwright.design-system.config.ts",
    "test:e2e:serve": "vite preview --host 127.0.0.1 --port 4174",
    "likes:dev": "wrangler dev --config workers/likes/wrangler.jsonc --port 8787",
    "likes:migrate:local": "wrangler d1 migrations apply DB --local --config workers/likes/wrangler.jsonc",
    "likes:migrate:remote": "wrangler d1 migrations apply DB --remote --config workers/likes/wrangler.jsonc",
    "likes:deploy": "wrangler deploy --config workers/likes/wrangler.jsonc",
    "likes:check": "tsc -p workers/likes/tsconfig.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.1.0",
    "@web-kits/audio": "^0.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.8.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260907.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.1.1",
    "agentation": "^2.2.1",
    "autoprefixer": "^10.5.5",
    "dialkit": "^2.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "ffmpeg-static": "^5.3.0",
    "globals": "^17.12.0",
    "motion": "^12.43.0",
    "pdfjs-dist": "^6.3.289",
    "postcss": "^8.4.38",
    "roughjs": "^4.6.6",
    "sharp": "0.35.4",
    "stylelint": "^17.15.0",
    "stylelint-config-recommended": "^18.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.1",
    "wrangler": "^4.129.0"
  },
  "overrides": {
    "miniflare@5.20260903.0-alpha": {
      "sharp": "0.35.4"
    }
  }
}
