{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "rafaelmedina-note-likes",
  "main": "index.ts",
  "compatibility_date": "2026-09-07",
  // The retired /chat API serves its static fallback; inference is disabled.
  "vars": {
    "CHAT_DAILY_LIMIT": "0",
    "CHAT_MONTHLY_LIMIT": "0",
    "ALLOWED_ORIGINS": "https://rafaelmedina.me,https://www.rafaelmedina.me,http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:4174,http://127.0.0.1:4175"
  },
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [{
    "name": "CHAT_LIMITER",
    "namespace_id": "1003",
    "simple": { "limit": 5, "period": 60 }
  }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "rafaelmedina-note-likes",
    "database_id": "3fb0c0c8-b14a-447f-a122-58cf2bab0ff4",
    "migrations_dir": "migrations"
  }],
  "env": {
    // Browser tests exercise local D1 with inference disabled. The AI and
    // throttle bindings are non-inherited, keeping CI credential-free.
    "e2e": {
      "vars": {
        "ALLOWED_ORIGINS": "http://127.0.0.1:4174",
        "CHAT_DAILY_LIMIT": "0",
        "CHAT_MONTHLY_LIMIT": "0"
      },
      "d1_databases": [{
        "binding": "DB",
        "database_name": "rafaelmedina-note-likes",
        "database_id": "3fb0c0c8-b14a-447f-a122-58cf2bab0ff4",
        "migrations_dir": "migrations"
      }]
    }
  }
}
